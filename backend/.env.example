# Gere credenciais em Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tribes-media
R2_ENDPOINT=https://88f67df82791b16d9aa1f5c4be6a2685.r2.cloudflarestorage.com
R2_REGION=auto

# Opcional: endereço acessível pelo navegador para URLs assinadas locais.
# Na produção, deixe vazio para usar R2_ENDPOINT.
R2_PUBLIC_ENDPOINT=

# E-mail local (padrão para execução com Docker Compose).
EMAIL_PROVIDER=mailhog
SMTP_URL=smtp://mailhog:1025
EMAIL_FROM="Tribes <no-reply@tribes.local>"
FRONTEND_URL=http://localhost:4317

# Chave pública da Geoapify usada pelo frontend para mapas e busca de endereços.
MAPS_API=

# Para testar pelo Resend, use no backend/.env e preencha com sua chave privada:
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Remetente de teste do Resend; destinatários seguem as restrições da conta Resend.
# EMAIL_FROM="Tribes <onboarding@resend.dev>"
