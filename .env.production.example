# Copy to .env.production and replace every placeholder.
# Use URL-encoded special characters in DATABASE_URL credentials.
TRIBES_BIND_ADDRESS=127.0.0.1
TRIBES_HTTP_PORT=4317
FRONTEND_URL=https://tribes.example.com
DATABASE_URL=postgres://tribes:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/tribes
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=Tribes <no-reply@example.com>
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=tribes-media
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
